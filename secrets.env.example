# Every environment variable this stack reads, with placeholder or blank values.
# NEVER put a real value in this file - it is tracked, and the repository is public.
# `*.env` and `secrets/` are git-ignored; this `.example` file is the one exception.

# --- On the box: ~/ai-stack/secrets/api-key.env (chmod 600) -------------------
# Loaded by systemd/llama-swap.service (EnvironmentFile), substituted into
# llama-swap.yaml as ${env.LLM_API_KEY}, and sourced by bin/run-openwebui.sh.
# Generate: printf 'LLM_API_KEY=sk-%s\n' "$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48)"
LLM_API_KEY=sk-replace-me

# Optional. Served context length for bin/run-qwen38.sh; blank = 500000.
# (examples/run-gpt-oss.sh reads it too; blank = 131072.)
CTX_LEN=

# HOME is also read - llama-swap.yaml uses ${env.HOME} and the launchers use
# $HOME. systemd sets it for a user service; do not set it here.

# --- One-time host setup: bin/privileged-setup.sh, bin/enable-firewall.sh ----
# Local subnet in CIDR form, allowed through ufw. Can be passed as the first
# argument instead. No default: a private-network address never goes in the repo.
LAN_CIDR=
# Account that owns the stack (linger). Blank = the account that ran sudo.
STACK_USER=

# --- Benchmark client only: scripts/depth-concurrency.sh (not on the box) -----
# Endpoint, e.g. http://<spark-ip>:9292. No default, for the same reason.
LLM_HOST=
# The same bearer token as LLM_API_KEY, under the name llama-benchy expects.
OPENAI_API_KEY=
# Issue number where the load-test window was announced. The box is shared; the
# script refuses to run without it. See AGENTS.md.
ANNOUNCED_ISSUE=
# Set to 1 to print the plan and contact nothing.
DRY_RUN=
